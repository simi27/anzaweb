---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Our Services',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Our Expertise"
    title="Comprehensive Media & Communications Services"
  />

  <Features
    columns={3}
    items={[
      {
        title: 'Graphic Design & Branding',
        description:
          'Corporate branding, vehicle branding, wall branding, outdoor signage, digital and print design.',
        icon: 'tabler:palette',
        callToAction: { text: 'Learn More →', href: '/services/printing-branding' },
      },
      {
        title: 'Printing Services',
        description:
          'Digital printing, screen printing, large format, metal fabrication, and exhibition materials.',
        icon: 'tabler:printer',
        callToAction: { text: 'Learn More →', href: '/services/printing-branding' },
      },
      {
        title: 'ICT Equipment',
        description:
          'Computers, peripherals, networking, servers, software development, and security systems.',
        icon: 'tabler:device-laptop',
        callToAction: { text: 'Learn More →', href: '/services/ict-stationery' },
      },
      {
        title: 'Stationery Supplies',
        description:
          'Office, school and home stationery, printing consumables, art supplies, and general supplies.',
        icon: 'tabler:backpack',
        callToAction: { text: 'Learn More →', href: '/services/ict-stationery' },
      },
      {
        title: 'Car Rental',
        description:
          'Tours, safari, vacation, business travel, and community service transportation. Safe and reliable.',
        icon: 'tabler:car',
        callToAction: { text: 'Learn More →', href: '/services/car-rental' },
      },
      {
        title: 'Timber Works',
        description:
          'Sawing, wood splitting, woodchips, and various wood product manufacturing.',
        icon: 'tabler:tree',
        callToAction: { text: 'Learn More →', href: '/services/timber-works' },
      },
    ]}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Discuss Your Project', href: '/contact', icon: 'tabler:arrow-right' },
    ]}
  >
    <Fragment slot="title">Not sure which service you need?</Fragment>
    <Fragment slot="subtitle">Tell us what you're trying to achieve and we'll recommend the best approach.</Fragment>
  </CallToAction>
</Layout>
