---
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About Tomarac"
    title="Your Partner in Visual Communications"
  />

  <Content
    isReversed
    tagline="Who We Are"
    title="A Multimedia House for a Diverse World"
    items={[
      {
        title: 'Our Story',
        description:
          'Tomarac is the media house lineup of communications services that provides for a diverse palette of sectors using the strength of written, visual and print content to relay messages, interpret ideas for everyday solutions, and connect all consumers of communications with the world around them.',
      },
      {
        title: 'Our Foundation',
        description:
          'Formed out of years of experience in multimedia and communication, our services are designed to respond directly to everyday communication challenges. We deliver in both English and Swahili, ensuring our clients effectively connect with audiences across the country.',
      },
      {
        title: 'Our Beginning',
        description:
          'Established in 2024, seven highly experienced individuals came together to supply promotion items, computers, stationery, ICT equipment, car hire, printing & advertising services, and timber works — all under one roof.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Tomarac Team',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-orange-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Stats
    tagline="By the Numbers"
    title="Tomarac at a Glance"
    stats={[
      { title: 'Founded', amount: '2024' },
      { title: 'Service Lines', amount: '6+' },
      { title: 'Languages', amount: 'EN & SW' },
      { title: 'Expert Team', amount: '7' },
    ]}
  />

  <Content
    tagline="Our Code of Battle"
    title="Five Principles That Guide Us"
    items={[
      {
        title: '1. Implementation',
        description: 'Ensure clients can successfully implement their brand consistently — no gap between vision and reality.',
      },
      {
        title: '2. Partnership',
        description: 'Build long-term branding and solution-oriented relationships that scale regionally and internationally.',
      },
      {
        title: '3. Value',
        description: 'Deliver technical solutions and add tangible value to every brand management engagement.',
      },
      {
        title: '4. Pan-African',
        description: 'Answer the call of pan-African and continental networks, connecting businesses across borders.',
      },
      {
        title: '5. Self-Reflection',
        description: '"Self-critical — there is always a better way." Continuous improvement drives everything we do.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Our Values',
    }}
  />
</Layout>
