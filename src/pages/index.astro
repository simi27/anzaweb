---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Brands from '~/components/widgets/Brands.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Contact from '~/components/widgets/Contact.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Tomarac Company Ltd — From Concept to Creation',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Our Services',
        href: '#services',
        icon: 'tabler:arrow-right',
      },
      {
        text: 'Start a Project',
        href: '#contact',
        icon: 'tabler:message',
      },
    ]}
    image={{ src: '/assets/logo_full.png', alt: 'Tomarac Company Limited' }}
  >
    <Fragment slot="title">
      There's <span class="text-primary dark:text-white">Tomarac</span><br class="block sm:hidden" />
      and There's <span class="text-primary dark:text-white">"Not Exactly"</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">From Concept to Creation.</span>
      <br />
      A multimedia house delivering branding, printing, ICT, and communications solutions across Tanzania.
    </Fragment>
  </Hero>

  <!-- Stats Widget — Trust Signals -->

  <Stats
    stats={[
      { title: 'Founded', amount: '2024' },
      { title: 'Service Lines', amount: '6+' },
      { title: 'Expert Team', amount: '7' },
      { title: 'Languages', amount: 'EN & SW' },
    ]}
  />

  <!-- Brands Widget — Trusted By -->

  <Brands
    title="Trusted By"
    subtitle="Government, corporate, and institutional partners"
    images={[
      { src: '/assets/tomarac/comp1.png', alt: 'Tanzania Government' },
      { src: '/assets/tomarac/comp2.png', alt: 'NEC Tanzania' },
      { src: '/assets/tomarac/comp4.png', alt: 'Vodacom' },
      { src: '/assets/tomarac/comp6.png', alt: 'TPDF' },
      { src: '/assets/tomarac/comp13.png', alt: 'Barrick Gold' },
      { src: '/assets/tomarac/comp3.png', alt: 'ACISP' },
    ]}
  />

  <!-- About / Code of Battle -->

  <Content
    isReversed
    tagline="Who We Are"
    title="Your Partner in Visual Communications"
    items={[
      {
        title: 'A Multimedia House',
        description:
          'Tomarac is the media house lineup of communications services that provides for a diverse palette of sectors using the strength of written, visual and print content to relay messages, interpret ideas for everyday solutions, and connect consumers with the world around them.',
      },
      {
        title: 'Experience That Delivers',
        description:
          'Formed out of years of experience in multimedia and communication, our services respond directly to everyday communication challenges. We deliver in both English and Swahili, ensuring our clients effectively connect with audiences across the country.',
      },
      {
        title: 'Founded in 2024',
        description:
          'Seven highly experienced individuals came together to supply promotion items, computers, stationery, ICT equipment, car hire, printing & advertising services, and timber works.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Our Code of Battle</h3>
      <ol class="list-decimal list-inside space-y-2 text-gray-600 dark:text-gray-300">
        <li>Ensure clients can successfully implement their brand consistently</li>
        <li>Build long-term branding and solution-oriented relationships</li>
        <li>Deliver technical solutions and add value to brand management</li>
        <li>Answer the call of pan-African and continental networks</li>
        <li>Self-critical — there is always a better way</li>
      </ol>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-orange-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Services Section -->

  <Features
    id="services"
    tagline="Our Expertise"
    title="Comprehensive Media & Communications Services"
    subtitle="From creative design to ICT infrastructure, we deliver end-to-end solutions that bring your vision to life."
    columns={3}
    items={[
      {
        title: 'Graphic Design & Branding',
        description:
          'Corporate branding, vehicle branding, wall branding, outdoor signage, digital and print design. Logo & Identity, Vehicle & Wall Branding, Billboards & Signage.',
        icon: 'tabler:palette',
      },
      {
        title: 'Printing Services',
        description:
          'Digital printing, screen printing, large format, metal fabrication, and exhibition materials. Brochures & Catalogues, Annual Reports & Manuals, Promotional Materials.',
        icon: 'tabler:printer',
      },
      {
        title: 'ICT Equipment',
        description:
          'Computers, peripherals, networking, servers, software development, and security systems. Hardware & Peripherals, Networking & Security, Software Development.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Stationery Supplies',
        description:
          'Office, school and home stationery, printing consumables, art supplies, and general supplies. Office & School Supplies, Printing Consumables, Art & Craft Supplies.',
        icon: 'tabler:backpack',
      },
      {
        title: 'Car Rental',
        description:
          'Tours, safari, vacation, business travel, and community service transportation. Safe, reliable vehicles for corporate, government, and leisure clients.',
        icon: 'tabler:car',
      },
      {
        title: 'Timber Works',
        description:
          'Sawing, wood splitting, woodchips, and various wood product manufacturing. Quality timber processing for industrial and commercial use.',
        icon: 'tabler:tree',
      },
    ]}
  />

  <!-- Our Process -->

  <Steps
    tagline="Our Process"
    title="How We Bring Ideas to Life"
    subtitle="From the first brainstorm to the final creation, we follow a proven creative process."
    items={[
      {
        title: '<span class="font-medium">Brainstorm</span>',
        description: 'Understanding your vision and goals. We listen, ask questions, and dig deep to understand what you need.',
        icon: 'tabler:bulb',
      },
      {
        title: '<span class="font-medium">Concept</span>',
        description: 'Developing creative direction. Mood boards, sketches, and design concepts that capture your brand essence.',
        icon: 'tabler:brush',
      },
      {
        title: '<span class="font-medium">Sketches</span>',
        description: 'Refining the design approach. Iterative feedback and polish until every detail is right.',
        icon: 'tabler:pencil',
      },
      {
        title: '<span class="font-medium">Creation</span>',
        description: 'Delivering the final product. On time, on brief, on budget — from concept to creation.',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Contact Section -->

  <Contact
    title="Let's Create Something Extraordinary Together"
    subtitle="Ready to start your next project? Reach out to our team. We'll work with you to understand your needs and deliver communications that make an impact."
    tagline="Get in Touch"
    inputs={[
      { type: 'text', name: 'name', placeholder: 'Your Full Name', autocomplete: 'name', label: 'Full Name' },
      { type: 'email', name: 'email', placeholder: 'Your Email', autocomplete: 'email', label: 'Email' },
      { type: 'text', name: 'service', placeholder: 'Service Needed (e.g., Graphic Design, Car Rental)', label: 'Service Needed' },
    ]}
    textarea={{ name: 'message', placeholder: 'Tell us about your project...', label: 'Message' }}
    button="Send Message"
    description="tomarac2024@gmail.com | +255 713 636 928 | Or download our company profile below."
  />

  <!-- CallToAction Widget -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Download Company Profile',
        href: '/assets/tomaracprofile.pdf',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      There's <span class="text-primary">Tomarac</span> and There's "Not Exactly"
    </Fragment>

    <Fragment slot="subtitle">
      Trusted for reliable, creative, and professional communications services across Tanzania.
    </Fragment>
  </CallToAction>
</Layout>
