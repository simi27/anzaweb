---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Contact from '~/components/widgets/Contact.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Tomarac Company Limited — Multi-Sector Service Provider',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get a Quote',
        href: '/contact',
        icon: 'tabler:arrow-right',
      },
      {
        text: 'Download Profile',
        href: '/assets/tomaracprofile.pdf',
        icon: 'tabler:download',
      },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Tomarac Company Limited' }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">From Concept</span>
      <br class="block sm:hidden" />
      <span class="hidden sm:inline"> </span>to Creation
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold text-primary">There's TOMARAC and There's 'Not Exactly'.</span>
      <br />
      Tanzania's trusted multi-sector partner — Mobility, Branding, ICT Supplies & Timber Works — all under one roof.
    </Fragment>
  </Hero>

  <!-- Stats Widget — Trust Signals -->

  <Stats
    stats={[
      { title: 'Established', amount: '2024' },
      { title: 'Licenses', amount: '8+' },
      { title: 'Bankers', amount: '2' },
      { title: 'Sectors', amount: '4' },
    ]}
  />

  <!-- Features Widget — 4 Service Verticals -->

  <Features
    id="services"
    tagline="What We Do"
    title="Four Verticals, One Standard of Excellence"
    subtitle="From moving your team to building your brand — Tomarac delivers across every touchpoint of your business."
    items={[
      {
        title: 'Mobility & Logistics',
        description:
          'Fleet of Land Cruisers, Alphards, and buses for corporate, government, tourism, and event transport. Field-ready, secure, and punctual.',
        icon: 'tabler:car',
      },
      {
        title: 'Printing & Branding',
        description:
          'Full-service creative production: graphic design, large-format printing, 3D signage, vehicle branding, and promotional merchandise.',
        icon: 'tabler:palette',
      },
      {
        title: 'ICT & Stationery',
        description:
          'Hardware, software, networking, security systems, and office consumables. Quality supplies so you can work, perform, and deliver.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Timber Works',
        description:
          'Sawing, splitting, and supply of wood products — sawdust, woodchips, strips, and more for industrial and commercial use.',
        icon: 'tabler:tree',
      },
    ]}
  />

  <!-- Content Widget — The Code of Battle -->

  <Content
    isReversed
    tagline="Our Ethos"
    title="The Tomarac Code of Battle"
    items={[
      {
        title: 'Implementation',
        description:
          'We ensure every client can implement their brand and operations consistently — no gaps between vision and reality.',
      },
      {
        title: 'Partnership',
        description:
          'We build long-term, solution-oriented relationships that scale regionally and internationally.',
      },
      {
        title: 'Value',
        description:
          'Group procurement and technical expertise that add tangible value to every engagement.',
      },
      {
        title: 'Self-Reflection',
        description:
          '"Self Critical... there is always a better way." Continuous improvement drives everything we do.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Built on Values</h3>
      Integrity, continuity, safety, and convenience — the foundation of every client relationship.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-orange-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget — Under One Roof -->

  <Content
    isAfterContent
    tagline="The Ecosystem"
    title="Your Campaign Support Partner"
    items={[
      {
        title: 'Logistics + Visibility',
        description:
          'Need a vehicle for your public awareness campaign? Don\'t forget the branding. We deliver both.',
      },
      {
        title: 'Supplies + Execution',
        description:
          'From ICT hardware to promotional merchandise — one vendor, one invoice, zero hassle.',
      },
      {
        title: 'Government Ready',
        description:
          'Fully licensed (TIN, BRELA, BASATA, LATRA) and compliant for governmental and institutional contracts.',
      },
    ]}
  >
    <Fragment slot="content">The "Under One Roof" advantage — fewer vendors, better coordination, stronger results.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget — How It Works -->

  <Steps
    title="From First Call to Project Completion"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Consult</span>',
        description:
          'Tell us your needs. Whether it\'s a fleet for a government tour, branded uniforms, or office setup — we listen first.',
        icon: 'tabler:message',
      },
      {
        title: 'Step 2: <span class="font-medium">Concept</span>',
        description:
          'We develop a tailored solution with clear timelines, pricing, and deliverables.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Step 3: <span class="font-medium">Execute</span>',
        description:
          'Our team mobilizes — vehicles arrive, prints roll, supplies are delivered. On time, every time.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Delivered!',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Contact Widget -->

  <Contact
    title="Let's Talk"
    subtitle="Whether you need a single vehicle, a full branding campaign, or ongoing supply — reach out."
    tagline="Get in Touch"
    inputs={[
      { type: 'text', name: 'name', placeholder: 'Your Name', autocomplete: 'name', label: 'Name' },
      { type: 'email', name: 'email', placeholder: 'Your Email', autocomplete: 'email', label: 'Email' },
      { type: 'text', name: 'phone', placeholder: 'Your Phone', autocomplete: 'tel', label: 'Phone' },
    ]}
    textarea={{ name: 'message', placeholder: 'Tell us about your project...', label: 'Message' }}
    button="Send Message"
    description="Or reach us directly: tomarac2024@gmail.com / +255 713 636 928"
  />

  <!-- CallToAction Widget -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Download Company Profile',
        href: '/assets/tomaracprofile.pdf',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Why risk <span class="text-primary">"Not Exactly"</span> when you can have Tomarac?
    </Fragment>

    <Fragment slot="subtitle">
      Trusted by clients across Tanzania for reliable service, premium quality, and end-to-end support.
      <br class="hidden md:inline" />Let's build something together.
    </Fragment>
  </CallToAction>
</Layout>
