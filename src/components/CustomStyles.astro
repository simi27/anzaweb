---
import '@fontsource-variable/montserrat';
import '@fontsource/lato';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Lato';
    --aw-font-serif: 'Lato';
    --aw-font-heading: 'Montserrat Variable', 'Montserrat';

    --aw-color-primary: rgb(245 130 32);    /* Tomarac Orange */
    --aw-color-secondary: rgb(220 100 0);     /* Darker Orange */
    --aw-color-accent: rgb(38 59 140);        /* Royal Blue */

    --aw-color-text-heading: rgb(0 28 62);    /* Deep Navy */
    --aw-color-text-default: rgb(30 30 30);
    --aw-color-text-muted: rgb(100 100 100);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);

    ::selection {
      background-color: rgb(245 130 32 / 20%);
    }
  }

  .dark {
    --aw-font-sans: 'Lato';
    --aw-font-serif: 'Lato';
    --aw-font-heading: 'Montserrat Variable', 'Montserrat';

    --aw-color-primary: rgb(245 130 32);
    --aw-color-secondary: rgb(220 100 0);
    --aw-color-accent: rgb(38 59 140);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(3 6 32);

    ::selection {
      background-color: rgb(245 130 32 / 40%);
    }
  }
</style>
